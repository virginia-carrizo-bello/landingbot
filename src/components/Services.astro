---
import { site } from '../content/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const { services } = site;
---

<section id="servicios" aria-labelledby="servicios-title" class="section">
  <div class="container-x">
    <SectionHeading id="servicios-title" eyebrow={services.eyebrow} title={services.title} subtitle={services.subtitle} />
    <ul class="grid gap-5 md:grid-cols-2">
      {
        services.items.map((item, i) => (
          <li
            class="card group relative overflow-hidden p-7 transition-shadow hover:shadow-xl hover:shadow-violet/10 sm:p-9"
            data-reveal
            style={`--reveal-i: ${i}`}
          >
            <div class="flex items-start justify-between gap-4">
              <span class="grid size-14 place-items-center rounded-2xl bg-violet text-white transition-transform group-hover:-rotate-6">
                <Icon name={item.icon} size={28} />
              </span>
              {item.tag && <span class="rounded-full bg-lime px-3 py-1 text-xs font-bold text-ink">{item.tag}</span>}
            </div>
            <h3 class="mt-6 text-2xl font-bold">{item.title}</h3>
            <p class="mt-3 text-ink-soft">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
