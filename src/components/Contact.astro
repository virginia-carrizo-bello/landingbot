---
import { site } from '../content/site';
import { contactLink, highlight } from '../lib/whatsapp';
import Icon from './Icon.astro';

const { contactSection: c, contact, form } = site;
const isNetlify = form.provider === 'netlify';
const action = isNetlify ? '/gracias/' : `https://formspree.io/f/${form.formspreeId}`;

const inputClass =
  'mt-2 block w-full rounded-xl border border-line bg-paper px-4 py-3 text-base text-ink placeholder:text-ink-soft/70 focus:border-violet focus:outline-none focus:ring-2 focus:ring-violet/30';
---

<section id="contacto" aria-labelledby="contacto-title" class="section on-dark bg-ink text-white">
  <div class="container-x grid gap-12 lg:grid-cols-2 lg:gap-20">
    <div data-reveal>
      <p class="mb-3 inline-block rounded-full bg-white/10 px-3 py-1 text-sm font-semibold text-lime">{c.eyebrow}</p>
      <h2 id="contacto-title" class="text-3xl font-bold sm:text-5xl" set:html={highlight(c.title)} />
      <p class="mt-4 text-lg text-white/75">{c.text}</p>

      <div class="mt-8 flex flex-col gap-4">
        <a href={contactLink} target="_blank" rel="noopener" class="btn btn-wa self-start text-lg">
          <Icon name="whatsapp" size={22} />
          {c.whatsappCta}
        </a>
        <a href={`mailto:${contact.email}`} class="inline-flex items-center gap-3 self-start rounded-lg py-2 text-lg text-white/85 hover:text-lime">
          <Icon name="mail" size={22} />
          {contact.email}
        </a>
      </div>
    </div>

    <form
      method="POST"
      action={action}
      name={isNetlify ? form.netlifyName : undefined}
      data-netlify={isNetlify ? 'true' : undefined}
      netlify-honeypot={isNetlify ? 'bot-field' : undefined}
      data-provider={form.provider}
      class="rounded-[var(--radius-card)] bg-surface p-6 text-ink sm:p-8"
      data-reveal
      style="--reveal-i: 1"
    >
      {isNetlify && <input type="hidden" name="form-name" value={form.netlifyName} />}
      <!-- Campo trampa anti-spam: oculto para personas -->
      <p class="hidden" aria-hidden="true">
        <label>No completar: <input name={isNetlify ? 'bot-field' : '_gotcha'} tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="space-y-5">
        <div>
          <label for="f-name" class="font-semibold">{c.fields.name}</label>
          <input id="f-name" name="nombre" type="text" required autocomplete="name" class={inputClass} />
        </div>
        <div>
          <label for="f-business" class="font-semibold">{c.fields.business}</label>
          <input id="f-business" name="negocio" type="text" required autocomplete="organization" class={inputClass} />
        </div>
        <div>
          <label for="f-need" class="font-semibold">{c.fields.need}</label>
          <textarea id="f-need" name="necesidad" rows="4" required placeholder={c.fields.needPlaceholder} class={inputClass}></textarea>
        </div>
      </div>

      <button type="submit" class="btn btn-primary mt-6 w-full text-lg">
        {c.submit}
        <Icon name="arrow" size={20} />
      </button>
      <p class="mt-3 text-center text-sm text-ink-soft">{c.privacy}</p>
      <p class="mt-3 hidden rounded-xl bg-red-50 p-3 text-center text-sm text-red-800" role="alert" data-form-error>
        No se pudo enviar. Probá de nuevo o escribime por WhatsApp.
      </p>
    </form>
  </div>
</section>

<script>
  // Mejora progresiva para Formspree: envía sin salir del sitio y redirige a /gracias/.
  // Sin JS, el formulario igual funciona (Formspree muestra su propia página de confirmación).
  const formEl = document.querySelector<HTMLFormElement>('form[data-provider="formspree"]');
  formEl?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = formEl.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const error = formEl.querySelector<HTMLElement>('[data-form-error]')!;
    btn.disabled = true;
    error.classList.add('hidden');
    try {
      const res = await fetch(formEl.action, {
        method: 'POST',
        body: new FormData(formEl),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      window.location.href = '/gracias/';
    } catch {
      error.classList.remove('hidden');
      btn.disabled = false;
    }
  });
</script>
