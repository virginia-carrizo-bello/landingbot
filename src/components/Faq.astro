---
/**
 * Acordeón con <details>/<summary> nativos: accesible por teclado y lector
 * de pantalla, y funciona sin JavaScript.
 */
import { site } from '../content/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const { faq } = site;
---

<section id="faq" aria-labelledby="faq-title" class="section bg-violet-soft/60">
  <div class="container-x max-w-3xl">
    <SectionHeading id="faq-title" eyebrow={faq.eyebrow} title={faq.title} />
    <div class="space-y-3">
      {
        faq.items.map((item, i) => (
          <details class="card group" name="faq" data-reveal style={`--reveal-i: ${i % 3}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 rounded-[var(--radius-card)] p-5 text-left text-lg font-semibold sm:p-6">
              <h3 class="font-sans text-lg font-semibold tracking-normal">{item.q}</h3>
              <span class="faq-icon grid size-9 shrink-0 place-items-center rounded-full bg-violet-soft text-violet transition-transform duration-200">
                <Icon name="plus" size={20} />
              </span>
            </summary>
            <p class="px-5 pb-6 text-ink-soft sm:px-6">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
