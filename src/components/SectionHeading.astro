---
import { highlight } from '../lib/whatsapp';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
  dark?: boolean;
  center?: boolean;
}

const { id, eyebrow, title, subtitle, dark = false, center = true } = Astro.props;
---

<div class:list={['mb-12 max-w-2xl sm:mb-16', center && 'mx-auto text-center']} data-reveal>
  <p
    class:list={[
      'mb-3 inline-block rounded-full px-3 py-1 text-sm font-semibold',
      dark ? 'bg-white/10 text-lime' : 'bg-violet-soft text-violet',
    ]}
  >
    {eyebrow}
  </p>
  <h2 id={id} class:list={['text-3xl font-bold sm:text-5xl', dark ? 'text-white' : 'text-ink']} set:html={highlight(title)} />
  {subtitle && <p class:list={['mt-4 text-lg', dark ? 'text-white/75' : 'text-ink-soft']}>{subtitle}</p>}
</div>
