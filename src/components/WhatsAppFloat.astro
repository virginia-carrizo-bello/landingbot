---
import { site } from '../content/site';
import { contactLink } from '../lib/whatsapp';
import Icon from './Icon.astro';
---

<a
  href={contactLink}
  target="_blank"
  rel="noopener"
  class="fixed right-4 bottom-4 z-40 grid size-16 place-items-center rounded-full bg-wa text-white shadow-lg shadow-ink/30 ring-4 ring-paper transition-transform hover:scale-105 hover:bg-wa-dark sm:right-6 sm:bottom-6"
>
  <Icon name="whatsapp" size={32} />
  <span class="sr-only">{site.headerCta}</span>
</a>
